#pragma kernel CSMain

Texture2D<float> HeightTex        : register(t0);
RWTexture2D<float4> NormalTex     : register(u0);
int2 TexSize;
float2 RegionSize;  // 新增：区域在世界坐标的尺寸

[numthreads(8, 8, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= TexSize.x || id.y >= TexSize.y) return;

    // 采样
    float hC = HeightTex[int2(id.x, id.y)];
    float hR = HeightTex[int2(min(id.x + 1, TexSize.x - 1), id.y)];
    float hL = HeightTex[int2(max(id.x - 1, 0), id.y)];
    float hU = HeightTex[int2(id.x, min(id.y + 1, TexSize.y - 1))];
    float hD = HeightTex[int2(id.x, max(id.y - 1, 0))];

    // 每个像素的世界长度（与 SeparableFilter 的做法一致）
    float dx = RegionSize.x / TexSize.x;
    float dy = RegionSize.y / TexSize.y;

    // 用中心差分的真实水平位移（相邻两像素中心相距 2*dx / 2*dy）
    float3 Tx = float3(2.0 * dx, hR - hL, 0.0);
    float3 Tz = float3(0.0, hU - hD, 2.0 * dy);

    float3 N = normalize(cross(Tz, Tx));
    NormalTex[int2(id.x, id.y)] = float4(N * 0.5 + 0.5, 1.0);
}
