// SeparableFilterCS.compute  (Z 维一次跑完所有 slice；每 slice 自己的半径)
// 非归一化 + 边界补偿（避免边/角突变）
#pragma kernel Horizontal
#pragma kernel Vertical

Texture2DArray<float>   InputArray;
RWTexture2DArray<float> OutputArray;

int2   TexSize;       // (W,H)
int    SliceCount;    // N_omega
float2 RegionSize;    // (sx,sy)

// 每个 slice 的卷积半径（世界单位），长度 = SliceCount
StructuredBuffer<float> RadiiWorld;

static const float PI = 3.14159265358979323846;

float texelWorldX() { return RegionSize.x / TexSize.x; }
float texelWorldY() { return RegionSize.y / TexSize.y; }

float raisedCosine(float d, float R)
{
    if (R <= 0.0) return (d == 0.0) ? 1.0 : 0.0;
    float ad = abs(d); if (ad > R) return 0.0;
    return 0.5 * (cos(PI * d / R) + 1.0);
}

// ---------------- X pass ----------------
[numthreads(8, 8, 1)]
void Horizontal(uint3 id: SV_DispatchThreadID)
{
    if (id.x >= TexSize.x || id.y >= TexSize.y || id.z >= SliceCount) return;

    float R = RadiiWorld[id.z];
    if (R <= 0.0)
    {
        OutputArray[int3(int2(id.xy), id.z)] = InputArray[int3(int2(id.xy), id.z)];
        return;
    }

    const float texW = texelWorldX();
    int taps = max((int)floor(R / texW), 0);

    // 完整核权重和（位置无关）
    float w_full = 0.0;
    [loop] for (int off = -taps; off <= taps; ++off)
    {
        w_full += raisedCosine(abs(off) * texW, R);
    }

    float sum = 0.0;
    float w_edge = 0.0;
    [loop] for (int off = -taps; off <= taps; ++off)
    {
        int sx = (int)id.x + off;
        if (sx < 0 || sx >= TexSize.x) continue; // 不 clamp，越界跳过

        float w = raisedCosine(abs(off) * texW, R);
        if (w <= 0.0) continue;

        sum += InputArray[int3(int2(sx, id.y), id.z)] * w;
        w_edge += w;
    }

    float scale = (w_edge > 1e-8) ? (w_full / w_edge) : 1.0;
    OutputArray[int3(int2(id.xy), id.z)] = sum * scale; // 非归一化 + 边界补偿
}

// ---------------- Y pass ----------------
[numthreads(8, 8, 1)]
void Vertical(uint3 id: SV_DispatchThreadID)
{
    if (id.x >= TexSize.x || id.y >= TexSize.y || id.z >= SliceCount) return;

    float R = RadiiWorld[id.z];
    if (R <= 0.0)
    {
        OutputArray[int3(int2(id.xy), id.z)] = InputArray[int3(int2(id.xy), id.z)];
        return;
    }

    const float texH = texelWorldY();
    int taps = max((int)floor(R / texH), 0);

    float w_full = 0.0;
    [loop] for (int off = -taps; off <= taps; ++off)
    {
        w_full += raisedCosine(abs(off) * texH, R);
    }

    float sum = 0.0;
    float w_edge = 0.0;
    [loop] for (int off = -taps; off <= taps; ++off)
    {
        int sy = (int)id.y + off;
        if (sy < 0 || sy >= TexSize.y) continue;

        float w = raisedCosine(abs(off) * texH, R);
        if (w <= 0.0) continue;

        sum += InputArray[int3(int2(id.x, sy), id.z)] * w;
        w_edge += w;
    }

    float scale = (w_edge > 1e-8) ? (w_full / w_edge) : 1.0;
    OutputArray[int3(int2(id.xy), id.z)] = sum * scale;
}
