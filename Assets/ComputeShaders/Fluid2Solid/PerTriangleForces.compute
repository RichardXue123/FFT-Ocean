// PerTriangleForces.compute

#pragma kernel CS_TriangleForces

// ---------------------------------------------
// Buffers
// ---------------------------------------------
StructuredBuffer<uint3> _Triangles;
StructuredBuffer<float3> _VerticesLocal;

// 流体 → 固体（力学）
RWStructuredBuffer<float3> _OutForceWater;
RWStructuredBuffer<float3> _OutForceAir;
RWStructuredBuffer<float3> _OutTorque;
RWStructuredBuffer<float4> _OutVolume;   // xyz = centerSub * volume, w = volume

// 固体 → 流体（源项：排水通量）
// 每个三角形一条：单位都是 [m^3 / s]
RWStructuredBuffer<float> _OutVertFlux;  // y 方向体积通量（压水 / 抽水）
RWStructuredBuffer<float> _OutHorzFlux;  // xz 方向体积通量（水平扫水，用于 Kelvin 尾迹）

struct WaveGenData
{
    float3 position; // 水下中心点 (WS)
    float3 normal;   // 面法线 (WS)
    float  flux;     // 垂直通量 (m^3/s)
};
RWStructuredBuffer<WaveGenData> _OutWaveGenData;

// ---------------------------------------------
// Inputs / Params
// ---------------------------------------------
float4x4 _LocalToWorld;
float4x4 _WorldToLocal;

int _TriangleCount;

float _WaterDensity;
float _CdWater;       // 水下阻力 Cd
float _AirDensity;    // 空气密度
float _CdAir;         // 空气阻力 Cd
float _Gravity;

// region settings
float2 _RegionMin;
float  _RegionSize;
int    _Resolution;

// textures
Texture2D<float> _HeightMap;

// rigidbody info
float3 _ObjectVelocity;
float3 _AngularVelocity;
float3 _ObjectCOM;

// 风速（世界空间）
float3 _WindVelocity;

// ---------------------------------------------
// Sample height
// ---------------------------------------------
float SampleHeight(float2 worldXZ)
{
    float2 uv = (worldXZ - _RegionMin) / _RegionSize;
    uv = saturate(uv);

    uint w, h;
    _HeightMap.GetDimensions(w, h);
    float2 coordF = uv * (float2(w, h) - 1.0);
    int2 coord = (int2)(coordF + 0.5);

    return _HeightMap.Load(int3(coord, 0)).r;
}

// ---------------------------------------------
// RigidBody point velocity
// ---------------------------------------------
float3 GetVelocityAtPoint(float3 worldPos)
{
    float3 r = worldPos - _ObjectCOM;
    float3 angular = cross(_AngularVelocity, r);
    return _ObjectVelocity + angular;
}

// ---------------------------------------------
// Submerged polygon (same as before, but volume 正值)
// ---------------------------------------------
void ComputeSubmergedTriangle(
    float3 w0, float3 w1, float3 w2,
    float d0, float d1, float d2,
    out float area, out float3 centerWS, out float volume)
{
    area = 0;
    centerWS = 0;
    volume = 0;

    bool s0 = (d0 > 0);
    bool s1 = (d1 > 0);
    bool s2 = (d2 > 0);

    float3 v[3] = { w0, w1, w2 };
    float  d[3] = { d0, d1, d2 };

    // fully submerged
    if (s0 && s1 && s2)
    {
        float3 e1 = w1 - w0;
        float3 e2 = w2 - w0;
        float3 n  = cross(e1, e2);
        float  A  = length(n) * 0.5;

        float3 C = (w0 + w1 + w2) / 3.0;

        area     = A;
        centerWS = C;

        // 用原来的近似体积公式
        float ny = normalize(n).y;
        float di = (d0 + d1 + d2) / 3.0;
        volume   = abs(A * di * ny);
        return;
    }

    // fully above
    if (!s0 && !s1 && !s2)
    {
        return;
    }

    // Mixed
    float3 inside[3];
    float3 outside[3];
    int inCount = 0;
    int outCount = 0;

    [unroll]
    for (int i = 0; i < 3; i++)
    {
        if (d[i] > 0)
        {
            inside[inCount++] = v[i];
        }
        else
        {
            outside[outCount++] = v[i];
        }
    }

    float3 poly[4];
    int pCount = 0;

    if (inCount == 1)
    {
        float3 A = inside[0];
        float3 B = outside[0];
        float3 C = outside[1];

        // 简化插值（以后可以按 index 精细对应）
        float3 interpAB = A + (B - A) * (abs(d0) / (abs(d0) + abs(d1)));
        float3 interpAC = A + (C - A) * (abs(d0) / (abs(d0) + abs(d2)));

        poly[0] = A;
        poly[1] = interpAB;
        poly[2] = interpAC;
        pCount  = 3;
    }
    else if (inCount == 2)
    {
        float3 A = inside[0];
        float3 B = inside[1];
        float3 C = outside[0];

        float3 I1 = A + (C - A) * (abs(d0) / (abs(d0) + abs(d2)));
        float3 I2 = B + (C - B) * (abs(d1) / (abs(d1) + abs(d2)));

        poly[0] = A;
        poly[1] = B;
        poly[2] = I1;
        poly[3] = I2;
        pCount  = 4;
    }

    float  totalA = 0;
    float3 totalC = 0;

    [unroll]
    for (int i = 1; i < pCount - 1; i++)
    {
        float3 a = poly[0];
        float3 b = poly[i];
        float3 c = poly[i + 1];

        float3 e1 = b - a;
        float3 e2 = c - a;
        float3 n  = cross(e1, e2);
        float  A  = length(n) * 0.5;

        float3 Ctri = (a + b + c) / 3.0;

        totalA += A;
        totalC += Ctri * A;
    }

    if (totalA > 0)
    {
        centerWS = totalC / totalA;
        area     = totalA;

        // 体积：仍然用原来的近似 + abs
        float di = (d0 + d1 + d2) / 3.0;
        float3 e1 = w1 - w0;
        float3 e2 = w2 - w0;
        float3 n  = cross(e1, e2);
        float ny  = normalize(n).y;
        volume = abs(totalA * di * ny);
    }
}

// ---------------------------------------------
// MAIN
// ---------------------------------------------
[numthreads(64,1,1)]
void CS_TriangleForces(uint id : SV_DispatchThreadID)
{
    if (id >= _TriangleCount) return;

    uint3 tri = _Triangles[id];

    float3 local0 = _VerticesLocal[tri.x];
    float3 local1 = _VerticesLocal[tri.y];
    float3 local2 = _VerticesLocal[tri.z];

    float3 w0 = mul(_LocalToWorld, float4(local0,1)).xyz;
    float3 w1 = mul(_LocalToWorld, float4(local1,1)).xyz;
    float3 w2 = mul(_LocalToWorld, float4(local2,1)).xyz;

    // ---- 全三角形几何（不考虑水线）----
    float3 e1_full = w1 - w0;
    float3 e2_full = w2 - w0;
    float3 n_full  = cross(e1_full, e2_full);
    float  areaFull = length(n_full) * 0.5;
    if (areaFull < 1e-8)
    {
        _OutForceWater[id] = 0;
        _OutForceAir[id]   = 0;
        _OutTorque[id]     = 0;
        _OutVolume[id]     = 0;

        _OutVertFlux[id]   = 0;
        _OutHorzFlux[id]   = 0;
        return;
    }
    float3 centerFull = (w0 + w1 + w2) / 3.0;

    // ---- 水面高度 & 深度 d = h - y（在水下 d>0）----
    float h0 = SampleHeight(w0.xz);
    float h1 = SampleHeight(w1.xz);
    float h2 = SampleHeight(w2.xz);

    float d0 = h0 - w0.y;
    float d1 = h1 - w1.y;
    float d2 = h2 - w2.y;

    // ---- 水下部分几何（面积 / 中心 / 体积）----
    float  areaSub;
    float3 centerSub;
    float  volume;
    ComputeSubmergedTriangle(w0, w1, w2, d0, d1, d2, areaSub, centerSub, volume);

    // ---- 由“全三角形 - 水下部分”得到水上部分 ----
    float  areaAir = 0;
    float3 centerAir = 0;

    const float eps = 1e-5;

    if (areaSub <= eps)
    {
        // 完全在水上
        areaAir   = areaFull;
        centerAir = centerFull;
        areaSub   = 0;
        centerSub = 0;
        volume    = 0;
    }
    else if (areaSub >= areaFull - eps)
    {
        // 完全在水下
        areaAir   = 0;
        centerAir = 0;
    }
    else
    {
        // 部分浸没：水上 = 全三角形 - 水下部分
        areaAir = max(areaFull - areaSub, 0);
        float3 momentFull = centerFull * areaFull;
        float3 momentSub  = centerSub * areaSub;
        float3 momentAir  = momentFull - momentSub;
        centerAir = momentAir / max(areaAir, eps);
    }

    // -------------------------------------------------
    // 1) 浮力数据写回（只用水下体积）
    // -------------------------------------------------
    if (volume <= 0)
    {
        _OutVolume[id] = 0;
    }
    else
    {
        _OutVolume[id] = float4(centerSub * volume, volume);
    }

    // -------------------------------------------------
    // 2) 水下 / 空气阻力 & 固体 → 液体体积通量
    // -------------------------------------------------
    float3 Fd_water = 0;
    float3 Tq_water = 0;

    float  vertFlux = 0;   // y 方向体积通量 [m^3/s]
    float  horzFlux = 0;   // xz 方向体积通量 [m^3/s]

    if (areaSub > eps)
    {
        float3 v_obj_sub = GetVelocityAtPoint(centerSub);
        float3 v_water   = float3(5,0,0);      // 之后可以用 WP 的水体速度
        float3 v_rel     = v_obj_sub - v_water;

        // ---- 固体→液体：体积通量（源项）----
        // 垂直方向：v_rel.y * 浸没面积
        vertFlux = v_rel.y * areaSub;

        // 水平方向：用速度在 xz 的长度 * 一个有效面积
        float2 vH = v_rel.xz;
        float  speedH = length(vH);

        float3 n_w   = normalize(n_full);
        float3 dir_v = (length(v_rel) > 1e-6) ? (v_rel / length(v_rel)) : float3(0,1,0);
        float  NdotV = dot(n_w, dir_v);
        float  Aproj = areaSub * max(0, abs(NdotV));   // 有效投影面积（可按需要调整）

        horzFlux = speedH * Aproj;

        // ---- 阻力（你之前的实现）----
        float  speed_w   = length(v_rel);
        if (speed_w > 1e-4 && _CdWater > 0)
        {
            float3 dir_w = v_rel / speed_w;
            float NdotVw = dot(n_w, dir_w);
            float AprojW = areaSub * max(0, NdotVw);

            Fd_water = -0.5 * _WaterDensity * _CdWater * AprojW * speed_w * v_rel;
            float3 r_w = centerSub - _ObjectCOM;
            Tq_water = cross(r_w, Fd_water);
        }
    }

    // ---- 空气阻力（风速相对）：只作用在水上的那部分 ----
    float3 Fd_air = 0;
    float3 Tq_air = 0;

    if (areaAir > eps && _CdAir > 0)
    {
        float3 v_obj_air = GetVelocityAtPoint(centerAir);
        float3 v_air     = _WindVelocity;          // 世界空间风速
        float3 v_rel_a   = v_obj_air - v_air;      // 物体相对风的速度

        float  speed_a   = length(v_rel_a);
        if (speed_a > 1e-4)
        {
            float3 dir_a = v_rel_a / speed_a;
            float3 n_a   = normalize(n_full);
            float NdotVa = dot(n_a, dir_a);
            float AprojA = areaAir * max(0, NdotVa);

            Fd_air = -0.5 * _AirDensity * _CdAir * AprojA * speed_a * v_rel_a;
            float3 r_a = centerAir - _ObjectCOM;
            Tq_air = cross(r_a, Fd_air);
        }
    }

    float3 Tq = Tq_water + Tq_air;

    _OutForceWater[id] = Fd_water;
    _OutForceAir[id]   = Fd_air;
    _OutTorque[id]     = Tq;

    // 固体 → 流体：每个三角形的排水“源项”
    _OutVertFlux[id]   = vertFlux;
    _OutHorzFlux[id]   = horzFlux;

    // 填充波浪生成数据
    WaveGenData wd;
    wd.position = centerSub; // 如果完全在水上，这里是0
    wd.normal   = normalize(n_full);
    wd.flux     = vertFlux;
    _OutWaveGenData[id] = wd;
}
